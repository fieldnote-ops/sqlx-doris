#!/usr/bin/env python3
"""Install/use the MSRV in external RUSTUP_HOME without changing global Rust."""
import os
from pathlib import Path
import subprocess
import sys
import argparse

project = Path(__file__).resolve().parents[1]
if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    os.execv(
        str(project / "scripts/dev"),
        [
            str(project / "scripts/dev"),
            sys.executable,
            "-B",
            str(Path(__file__).resolve()),
            *sys.argv[1:],
        ],
    )
os.chdir(project)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--macro-consumer",
    action="store_true",
    help="also check the offline consumer generated by scripts/test-macros",
)
args = parser.parse_args()
root = Path(os.environ["SQLX_DORIS_BUILD_ROOT"])
if (
    not (root / "target-msrv-clean")
    .resolve()
    .is_relative_to(Path(os.environ["SQLX_DORIS_EXTERNAL_VOLUME"]).resolve())
):
    raise SystemExit("MSRV build path escapes external volume")
os.environ["CARGO_BUILD_BUILD_DIR"] = str(root / "target-msrv-clean")
os.environ["RUSTUP_HOME"] = str(root / "runtime/rustup")
if subprocess.run(
    ["rustup", "run", "1.94.0", "rustc", "--version"], capture_output=True
).returncode:
    subprocess.run(
        [
            "rustup",
            "toolchain",
            "install",
            "1.94.0",
            "--profile",
            "minimal",
            "--no-self-update",
        ],
        check=True,
    )
prefix = ["rustup", "run", "1.94.0", "cargo"]
target = ["--target-dir", str(root / "target-msrv-clean")]
commands = [
    [*prefix, "test", "--locked", "--workspace", "--all-features", *target],
    [
        *prefix,
        "check",
        "--locked",
        "--workspace",
        "--no-default-features",
        "--all-targets",
        *target,
    ],
    [
        *prefix,
        "check",
        "--locked",
        "--workspace",
        "--all-features",
        "--lib",
        *target,
    ],
]
consumer_check = None
consumer_env = None
if args.macro_consumer:
    directory = root / "native-macro-consumers"
    manifest = directory / "consumer/Cargo.toml"
    cache = directory / "offline"
    if not manifest.is_file() or not list(cache.glob("query-*.json")):
        raise SystemExit("run scripts/test-macros before test-msrv --macro-consumer")
    consumer_check = [
        *prefix,
        "check",
        "--offline",
        "--manifest-path",
        str(manifest),
        *target,
    ]
    consumer_env = os.environ.copy()
    consumer_env.update(SQLX_OFFLINE="true", SQLX_OFFLINE_DIR=str(cache))
    consumer_env.pop("DATABASE_URL", None)
    commands.append(consumer_check)
log = Path(os.environ["SQLX_DORIS_ARTIFACTS_DIR"]) / "msrv.log"
with log.open("w") as output:
    for command in commands:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            env=consumer_env if command == consumer_check else None,
            cwd=manifest.parent if command == consumer_check else project,
        )
        for line in process.stdout:
            print(line, end="", flush=True)
            output.write(line)
        code = process.wait()
        output.flush()
        if code:
            raise SystemExit(code)
print(f"Rust 1.94.0 tests passed; log: {log}")
