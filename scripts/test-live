#!/usr/bin/env python3
"""Run real Doris contracts; missing prerequisites or skipped live tests fail."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *
import re
import json
import time
import argparse
from collections import Counter

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--group",
    choices=("full", "driver", "ingestion"),
    default="full",
    help="full is the release gate; smaller groups are scoped development checks",
)
args = parser.parse_args()
full = args.group == "full"
ingestion = args.group in ("full", "ingestion")
required = ["DORIS_TEST_URL"]
if ingestion:
    required += ["DORIS_HTTP_URL", "DORIS_BE_HTTP_URL"]
if full:
    required += [
        "DORIS_LOAD_FIXTURE_HOST",
        "DORIS_KAFKA_BROKERS",
        "DORIS_KAFKA_TOPIC",
        "DOCKER_HOST",
        "DORIS_KAFKA_CONTAINER",
        "DORIS_KAFKA_FAULT_MANIFEST",
        "DORIS_KAFKA_CONNECTION_FILE",
        "DORIS_KAFKA_SASL_CONNECTION_FILE",
    ]

for key in required:
    if not os.environ.get(key):
        raise SystemExit(f"{key} is required")
if full:
    for key in ("DORIS_KAFKA_CONNECTION_FILE", "DORIS_KAFKA_SASL_CONNECTION_FILE"):
        config = Path(os.environ[key])
        if (
            config.is_symlink()
            or not config.is_file()
            or not config.resolve().is_relative_to(
                Path(os.environ["SQLX_DORIS_EXTERNAL_VOLUME"]).resolve()
            )
            or config.stat().st_mode & 0o077
            or config.stat().st_size > 65536
        ):
            raise SystemExit(
                f"{key} must be a private regular external connection file"
            )
    fault_path = Path(os.environ["DORIS_KAFKA_FAULT_MANIFEST"])
    if (
        fault_path.is_symlink()
        or not fault_path.is_file()
        or not fault_path.resolve().is_relative_to(
            Path(os.environ["SQLX_DORIS_EXTERNAL_VOLUME"]).resolve()
        )
        or fault_path.stat().st_mode & 0o077
    ):
        raise SystemExit(
            "DORIS_KAFKA_FAULT_MANIFEST must be a private regular external file"
        )
    faults = json.loads(fault_path.read_text())
    if (
        len(faults.get("nodes", [])) != 2
        or not faults.get("owner")
        or not faults.get("image")
        or not faults.get("cluster_id")
    ):
        raise SystemExit(
            "owned two-broker fault manifest is required; see docs/TESTING.md"
        )
fixture_root = Path(os.environ["SQLX_DORIS_BUILD_ROOT"]) / "fixtures"
for folder, names in [
    (
        "tls",
        [
            "ca.pem",
            "server-cert.pem",
            "server-key.pem",
            "client-cert.pem",
            "client-key.pem",
            "wrong-ca.pem",
        ],
    ),
    ("stream-load", ["manifest.json", "sample.parquet", "sample.orc"]),
]:
    if not ingestion:
        continue
    for name in names:
        if not (fixture_root / folder / name).is_file():
            raise SystemExit(f"Missing fixture: {folder}/{name}; see docs/TESTING.md")
started = time.monotonic()
targets = []
features = ["--all-features"]
scope = ["--workspace"] if full else ["-p", "sqlx-doris"]
if args.group == "driver":
    targets = ["--test", "driver_live"]
    features = ["--no-default-features"]
elif args.group == "ingestion":
    targets = ["--test", "stream_load_live", "--test", "stream_load_tls_live"]
    features = ["--no-default-features", "--features", "stream-load"]
run(
    [
        [
            "cargo",
            "test",
            "--locked",
            "--offline",
            *scope,
            *features,
            *(["--tests"] if full else targets),
            "--",
            "--ignored",
            "--nocapture",
            "--test-threads=1",
        ]
    ],
    f"live-{args.group}.log",
)
counts = re.findall(
    r"test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;",
    (artifacts / f"live-{args.group}.log").read_text(),
)
passed = sum(int(c[0]) for c in counts)
if not passed or any(int(c[1]) or int(c[2]) for c in counts):
    raise SystemExit("Live tests were not fully executed")
executed = []
target = None
for line in (artifacts / f"live-{args.group}.log").read_text().splitlines():
    if match := re.search(r"Running tests/(\w+)\.rs", line):
        target = match[1]
    if match := re.match(r"test ([\w:]+) \.\.\.", line):
        name = match[1]
        if target == "migrate_live":
            domain = (
                "specialist_administration"
                if name.startswith("identity::")
                else "migration_and_locks"
            )
        elif target == "kafka_preflight_live":
            domain = "kafka_preflight"
        elif target in ("stream_load_live", "stream_load_tls_live"):
            domain = "ingestion"
        elif target in ("schema_live", "operations_live", "materialized_view_live"):
            domain = "application_helpers"
        else:
            domain = "driver_and_types"
        executed.append(dict(target=target, name=name, domain=domain))
if len(executed) != passed:
    raise SystemExit("Executed test names do not match the passing result count")
(artifacts / f"live-{args.group}-summary.json").write_text(
    json.dumps(
        dict(
            group=args.group,
            release_gate=full,
            passed=passed,
            seconds=time.monotonic() - started,
            domains=dict(Counter(test["domain"] for test in executed)),
            executed_tests=executed,
        ),
        indent=2,
    )
    + "\n"
)
if full:
    run([[sys.executable, "-B", "scripts/test-examples"]], "live-examples.log")
    run(
        [
            [sys.executable, "-B", "scripts/test-macros"],
            [sys.executable, "-B", "scripts/test-cli"],
        ],
        "live-tools.log",
    )
