#!/usr/bin/env python3
"""Verify isolated source/bundle consumers without a root patch, optionally live."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import time
import tomllib

project = Path(__file__).resolve().parents[1]
if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    os.execv(
        str(project / "scripts/dev"),
        [
            str(project / "scripts/dev"),
            sys.executable,
            "-B",
            str(Path(__file__).resolve()),
            *sys.argv[1:],
        ],
    )
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--live",
    action="store_true",
    help="require both TEST_URL variables and execute both real databases",
)
parser.add_argument(
    "--bundle", type=Path, help="exact compatibility archive on the external build root"
)
args = parser.parse_args()
if os.environ.get("CARGO_BUILD_TARGET"):
    raise SystemExit("test-consumer runs on the host; unset CARGO_BUILD_TARGET")
if args.live:
    for key in ["MYSQL_TEST_URL", "DORIS_TEST_URL"]:
        if not os.environ.get(key):
            raise SystemExit(f"{key} is required for --live")
root = Path(os.environ["SQLX_DORIS_BUILD_ROOT"])
# Shared live fixtures must not be created by two platform consumers at once.
if args.live:
    lock_path = root / "runtime/consumer-fixture.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fixture_lock = lock_path.open("a+")
    try:
        fcntl.flock(fixture_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(
            "another live consumer owns the fixed fixture; run consumers serially"
        )
host = next(
    line.split(": ", 1)[1]
    for line in subprocess.check_output(["rustc", "-vV"], text=True).splitlines()
    if line.startswith("host: ")
)
archive = (
    args.bundle
    or Path(os.environ["CARGO_TARGET_DIR"]) / "package/sqlx-doris-compat-0.1.0.tar.gz"
)
if not archive.resolve().is_relative_to(root.resolve()):
    raise SystemExit(
        "compatibility archive must remain on the selected external build root"
    )
if not archive.is_file():
    raise SystemExit(
        "run scripts/check to build the current compatibility bundle first"
    )
run = (
    Path(os.environ["SQLX_DORIS_ARTIFACTS_DIR"])
    / "consumer"
    / time.strftime("%Y%m%d-%H%M%S")
)
run.mkdir(parents=True, exist_ok=False)
with tarfile.open(archive) as package:
    package.extractall(run / "archive", filter="data")
bundle = run / "archive/sqlx-doris-compat-0.1.0"
for name, expected in json.loads((bundle / "SHA256SUMS.json").read_text()).items():
    if hashlib.sha256((bundle / name).read_bytes()).hexdigest() != expected:
        raise SystemExit(f"bundle checksum mismatch: {name}")
for name in ("README.md", "README.en.md"):
    if (bundle / "crates/sqlx-doris" / name).read_bytes() != (
        project / "crates/sqlx-doris" / name
    ).read_bytes():
        raise SystemExit(f"packaged {name} differs from current source; repackage first")

results = []
cases = [
    (
        "bundle",
        project / "crates/sqlx-doris/README.md",
        bundle / "crates/sqlx-doris",
    ),
    (
        "source",
        project / "docs/INSTALLATION.md",
        project / "crates/sqlx-doris",
    ),
]
for label, source, dependency in cases:
    text = source.read_text()
    snippet = re.search(r"```rust,no_run\n(.*?)\n```", text, re.S)
    if not snippet:
        raise SystemExit(f"missing installation program in {source}")
    if "[patch.crates-io]" in text:
        raise SystemExit(f"installation guide still requires a root patch: {source}")
    if "sqlx_doris::sqlx" not in text:
        raise SystemExit(f"installation guide lacks the patch-free SDK API: {source}")
    directory = run / (label + "-consumer")
    (directory / "src").mkdir(parents=True)
    rust = "\n".join(
        line[2:] if line.startswith("# ") else line for line in snippet[1].splitlines()
    )
    identity = r"""
pub fn same_pool(v: sqlx_doris::MySqlPool) -> sqlx_doris::sqlx::Pool<sqlx_doris::sqlx::MySql> {
    v
}
pub fn same_database(v: sqlx_doris::sqlx::MySql) -> sqlx_doris::sqlx::MySql {
    v
}
pub fn same_connection(
    v: sqlx_doris::sqlx::MySqlConnection,
) -> sqlx_doris::sqlx::MySqlConnection {
    v
}
pub fn same_row(v: sqlx_doris::sqlx::mysql::MySqlRow) -> sqlx_doris::sqlx::mysql::MySqlRow {
    v
}
pub fn same_transaction<'a>(
    v: sqlx_doris::sqlx::Transaction<'a, sqlx_doris::sqlx::MySql>,
) -> sqlx_doris::sqlx::Transaction<'a, sqlx_doris::sqlx::MySql> {
    v
}
"""
    (directory / "src/lib.rs").write_text(rust + identity)
    (directory / "src/main.rs").write_bytes(
        (project / "tools/consumer-compat.rs").read_bytes()
    )
    manifest = (
        '[package]\nname = "sqlx-doris-consumer"\nversion = "0.0.0"\nedition = "2024"\n'
        "[dependencies]\nsqlx-doris = { path = "
        + json.dumps(str(dependency))
        + ', default-features = false }\n'
        'sqlx = { version = "=0.9.0", default-features = false, features = ["derive"] }\n'
        'tokio = { version = "1", features = ["macros", "rt-multi-thread"] }\n'
    )
    (directory / "Cargo.toml").write_text(manifest)
    manifest_flags = ["--manifest-path", str(directory / "Cargo.toml")]
    flags = manifest_flags
    with (directory / "check.log").open("w") as output:

        def command(argv):
            output.write("$ " + " ".join(argv) + "\n")
            output.flush()
            subprocess.run(
                argv, cwd=project, stdout=output, stderr=subprocess.STDOUT, check=True
            )

        command(["cargo", "generate-lockfile", "--offline", *manifest_flags])
        command(["cargo", "check", "--locked", "--offline", *flags])
        # Use each guide's manifest and program without injecting dependencies.
        documented_applications = []
        for language in ("zh", "en"):
            documented_source = (
                source if language == "zh" else source.with_name(source.stem + ".en.md")
            )
            documented_text = documented_source.read_text()
            documented_rust = re.search(
                r"```rust,no_run\n(.*?)\n```", documented_text, re.S
            )
            if not documented_rust:
                raise SystemExit(f"missing documented main.rs in {documented_source}")
            documented_manifest = re.search(
                r"```toml\n(.*?)\n```", documented_text, re.S
            )
            if not documented_manifest:
                raise SystemExit(f"missing complete Cargo.toml in {documented_source}")
            manifest_text = re.sub(
                r"^sqlx-doris = .*$",
                'sqlx-doris = { path = '
                + json.dumps(str(dependency))
                + ", default-features = false }",
                documented_manifest[1],
                count=1,
                flags=re.M,
            )
            relocated = tomllib.loads(manifest_text)
            if "patch" in relocated:
                raise SystemExit(
                    f"documented manifest still patches crates.io: {documented_source}"
                )
            if str(relocated["dependencies"]["sqlx-doris"]["path"]) != str(dependency):
                raise SystemExit(
                    f"cannot relocate the documented SDK path in {documented_source}"
                )
            documented_directory = run / (label + "-" + language + "-documented-app")
            (documented_directory / "src").mkdir(parents=True)
            (documented_directory / "Cargo.toml").write_text(manifest_text + "\n")
            (documented_directory / "src/main.rs").write_text(documented_rust[1] + "\n")
            documented_flags = [
                "--manifest-path",
                str(documented_directory / "Cargo.toml"),
            ]
            command(["cargo", "generate-lockfile", "--offline", *documented_flags])
            command(["cargo", "check", "--locked", "--offline", *documented_flags])
            if args.live:
                documented_env = os.environ.copy()
                documented_env.update(
                    MYSQL_URL=documented_env["MYSQL_TEST_URL"],
                    DORIS_URL=documented_env["DORIS_TEST_URL"],
                )
                output.write("$ run the documented main.rs against both databases\n")
                output.flush()
                documented_run = subprocess.run(
                    ["cargo", "run", "--locked", "--offline", *documented_flags],
                    cwd=project,
                    env=documented_env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                )
                output.write(documented_run.stdout)
                output.flush()
                documented_run.check_returncode()
                for expected in (
                    "MySql: id=42, name=hello",
                    "Doris: id=42, name=hello",
                ):
                    if expected not in documented_run.stdout.splitlines():
                        raise SystemExit(
                            f"documented application output missing: {expected}"
                        )
            documented_applications.append(
                {
                    "language": language,
                    "source": str(documented_source),
                    "source_sha256": hashlib.sha256(
                        documented_source.read_bytes()
                    ).hexdigest(),
                    "compiled": True,
                    "live": args.live,
                }
            )

        metadata = json.loads(
            subprocess.check_output(
                [
                    "cargo",
                    "metadata",
                    "--locked",
                    "--offline",
                    "--format-version",
                    "1",
                    "--filter-platform",
                    host,
                    *manifest_flags,
                ],
                cwd=project,
            )
        )
        mysql = [p for p in metadata["packages"] if p["name"] == "sqlx-mysql"]
        driver_manifest = (dependency.parent / "sqlx-mysql" / "Cargo.toml").resolve()
        if len(mysql) != 1 or mysql[0]["version"] != "0.9.0":
            raise SystemExit(f"duplicate/unexpected sqlx-mysql identity: {mysql}")
        if Path(mysql[0]["manifest_path"]).resolve() != driver_manifest:
            raise SystemExit("consumer did not resolve the bundled driver source")
        if mysql[0]["source"] is not None:
            raise SystemExit("bundled driver unexpectedly resolved from a registry")
        (directory / "metadata.json").write_text(json.dumps(metadata, indent=2) + "\n")
        if args.live:
            command(["cargo", "run", "--locked", "--offline", *flags])
    results.append(
        {
            "source": str(source),
            "source_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
            "dependency": str(dependency),
            "sqlx_mysql_manifest": mysql[0]["manifest_path"],
            "default_features": False,
            "compiled": True,
            "documented_manifest_and_main_compiled": True,
            "documented_application_live": args.live,
            "documented_applications": documented_applications,
            "single_native_mysql_identity": True,
            "root_patch_required": False,
            "live": "both databases passed" if args.live else "not run",
            "evidence": str(directory / "check.log"),
        }
    )
    print(f"{label} consumer passed", flush=True)
(run / "summary.json").write_text(
    json.dumps(
        {
            "bundle_sha256": hashlib.sha256(archive.read_bytes()).hexdigest(),
            "target": host,
            "consumers": results,
        },
        indent=2,
    )
    + "\n"
)
print(f"Independent consumers verified: {run}")
