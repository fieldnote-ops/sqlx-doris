#!/usr/bin/env python3
"""Build an isolated SQLx/Doris consumer and reject extra database drivers."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *
import json
import argparse

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--live", action="store_true")
args = parser.parse_args()
if args.live and not os.environ.get("DORIS_TEST_URL"):
    raise SystemExit("DORIS_TEST_URL is required for --live")
# Separate manifests prevent workspace dev-dependencies from hiding feature leaks.
host = next(
    line.removeprefix("host: ")
    for line in subprocess.check_output(["rustc", "-vV"], text=True).splitlines()
    if line.startswith("host: ")
)
feature_results = []
for case, features, upstream in [
    ("driver-only", [], None),
    ("migrate-only", ["migrate"], None),
    ("macros-only", ["macros"], None),
    ("checked-migrate", ["macros", "migrate"], None),
    ("operations-only", ["operations"], None),
    ("stream-load-only", ["stream-load"], None),
    ("cli-only", ["cli"], None),
    ("cli-admin", ["cli-admin"], None),
    ("cli-admin-kafka", ["cli-admin-kafka"], None),
    ("runtime-minimal", [], []),
    ("upstream-macros", ["migrate"], ["macros", "migrate"]),
]:
    fixture = Path(os.environ["SQLX_DORIS_BUILD_ROOT"]) / "consumer-features" / case
    (fixture / "src").mkdir(parents=True, exist_ok=True)
    upstream_dependency = (
        'sqlx = { version = "=0.9.0", default-features = false, features = '
        + json.dumps(upstream)
        + " }\n"
        if upstream is not None
        else ""
    )
    (fixture / "Cargo.toml").write_text(
        f"""[package]
name = "doris-consumer-{case}"
version = "0.0.0"
edition = "2024"
[workspace]
[dependencies]
sqlx-doris = {{ path = {json.dumps(str(project / "crates/sqlx-doris"))}, default-features = false, features = {json.dumps(features)} }}
{upstream_dependency}"""
    )
    source = "pub use sqlx_doris::Doris;\n"
    if upstream is not None:
        source += """pub async fn answer(pool: &sqlx::Pool<Doris>) -> sqlx::Result<i64> {
    sqlx::query_scalar("SELECT CAST(? AS BIGINT)")
        .bind(42_i64)
        .fetch_one(pool)
        .await
}
pub fn pool(options: sqlx_doris::DorisPoolOptions) -> sqlx::Pool<Doris> {
    options.connect_lazy("doris://root@localhost/app").unwrap()
}
"""
    if "macros" in (upstream or []):
        (fixture / "migrations").mkdir(exist_ok=True)
        (fixture / "migrations/1_check.sql").write_text("SELECT 1;\n")
        source += """pub static MIGRATIONS: sqlx::migrate::Migrator = sqlx::migrate!("./migrations");
pub async fn migrate(pool: &sqlx::Pool<Doris>) -> Result<(), sqlx::migrate::MigrateError> {
    MIGRATIONS.run(pool).await
}
"""
    (fixture / "src/lib.rs").write_text(source)
    manifest_args = ["--manifest-path", str(fixture / "Cargo.toml")]
    run([["cargo", "check", "--offline", *manifest_args]], "consumer-" + case + ".log")
    tree = subprocess.check_output(
        [
            "cargo",
            "tree",
            "--offline",
            *manifest_args,
            "--edges",
            "normal,build",
            "--prefix",
            "none",
            "--format",
            "{p}",
        ],
        text=True,
        cwd=fixture,
    )
    (artifacts / ("consumer-" + case + "-dependencies.txt")).write_text(tree)
    packages = {line.split()[0] for line in tree.splitlines() if line}
    forbidden = {
        "sqlx-mysql",
        "sqlx-postgres",
        "sqlx-sqlite",
    }
    if "macros" not in (upstream or []):
        forbidden.add("sqlx-macros")
    if "macros" not in features:
        forbidden.add("sqlx-doris-macros")
        if "macros" not in (upstream or []):
            forbidden.add("sqlx-macros-core")
    if upstream is None:
        forbidden.add("sqlx")
    is_cli = any(feature.startswith("cli") for feature in features)
    is_admin = bool(set(features).intersection(("cli-admin", "cli-admin-kafka")))
    if not is_cli:
        forbidden.update(("tokio-macros", "clap", "sqlx-doris-cli"))
    if not is_admin and "stream-load" not in features:
        forbidden.add("reqwest")
    if not is_cli and not set(features).intersection(("operations", "stream-load")):
        forbidden.add("sqlx-doris-ops")
    if extra := packages.intersection(forbidden):
        raise SystemExit(f"Unexpected dependencies for {case}: {sorted(extra)}")
    metadata = json.loads(
        subprocess.check_output(
            [
                "cargo",
                "metadata",
                "--offline",
                *manifest_args,
                "--filter-platform",
                host,
                "--format-version",
                "1",
            ],
            text=True,
            cwd=fixture,
        )
    )
    names = {package["id"]: package["name"] for package in metadata["packages"]}
    core_features = set().union(
        *(
            set(node["features"])
            for node in metadata["resolve"]["nodes"]
            if names[node["id"]] == "sqlx-core"
        )
    )
    if "offline" not in core_features:
        raise SystemExit(f"Executor::describe trait support is missing for {case}")
    doris_features = set().union(
        *(
            set(node["features"])
            for node in metadata["resolve"]["nodes"]
            if names[node["id"]] == "sqlx-doris-core"
        )
    )
    expected_features = {
        "macro-support": "macros" in features,
        "migrate": is_cli or "migrate" in features,
        "value-support": bool(
            set(features).intersection(("operations", "stream-load"))
        ),
    }
    for feature, expected in expected_features.items():
        if (feature in doris_features) != expected:
            raise SystemExit(f"Unexpected Doris feature {feature} for {case}")
    for package, expectations in {
        "sqlx-doris-cli": {
            "admin": is_admin,
            "kafka-admin": "cli-admin-kafka" in features,
        },
        "sqlx-doris-ops": {
            "cli-support": is_cli,
            "maintenance": is_admin,
            "kafka": "cli-admin-kafka" in features,
        },
    }.items():
        resolved = set().union(
            *(
                set(node["features"])
                for node in metadata["resolve"]["nodes"]
                if names[node["id"]] == package
            )
        )
        for feature, expected in expectations.items():
            if (feature in resolved) != expected:
                raise SystemExit(f"Unexpected {package}/{feature} for {case}")
    feature_results.append(
        dict(
            case=case,
            passed=True,
            packages=len(packages),
            sqlx_core_features=sorted(core_features),
            doris_core_features=sorted(doris_features),
        )
    )
(artifacts / "consumer-feature-summary.json").write_text(
    json.dumps(feature_results, indent=2) + "\n"
)
# Each internal ops feature must compile independently, without facade feature
# unification or dev dependencies from the public package hiding missing gates.
for feature in (None, "helpers", "stream-load", "cli-support", "maintenance", "kafka"):
    command = [
        "cargo",
        "clippy",
        "--offline",
        "--locked",
        "-p",
        "sqlx-doris-ops",
        "--no-default-features",
        "--lib",
    ]
    if feature:
        command.extend(["--features", feature])
    command.extend(["--", "-D", "warnings"])
    run([command], "ops-feature-" + (feature or "empty") + ".log")

# Cargo may enable an internal dependency's optional components independently
# of the selected CLI profile. Construction must not require CLI Kafka fields.
run(
    [
        [
            "cargo",
            "check",
            "--locked",
            "--offline",
            "-p",
            "sqlx-doris-cli",
            "-p",
            "sqlx-doris-ops",
            "--features",
            "sqlx-doris-cli/admin,sqlx-doris-ops/kafka",
        ],
    ],
    "cli-admin-unified-ops-kafka.log",
)

run(
    [
        [
            "cargo",
            "clippy",
            "--offline",
            "--locked",
            "-p",
            "sqlx-doris-macros",
            "--no-default-features",
            "--lib",
            "--",
            "-D",
            "warnings",
        ]
    ],
    "macros-feature-empty.log",
)
empty_macro_tree = subprocess.check_output(
    [
        "cargo",
        "tree",
        "--offline",
        "--locked",
        "-p",
        "sqlx-doris-macros",
        "--no-default-features",
        "--edges",
        "normal,build",
        "--prefix",
        "none",
        "--format",
        "{p}",
    ],
    text=True,
)
(artifacts / "macros-feature-empty-dependencies.txt").write_text(empty_macro_tree)
assert {line.split()[0] for line in empty_macro_tree.splitlines() if line} == {
    "sqlx-doris-macros"
}, "disabled query macros must not pull the compiler/driver stack"

directory = Path(os.environ["SQLX_DORIS_BUILD_ROOT"]) / "consumer-standalone"
directory.mkdir(parents=True, exist_ok=True)
(directory / "src").mkdir(exist_ok=True)
manifest = f"""[package]
name = "doris-consumer"
version = "0.0.0"
edition = "2024"
[workspace]
[dependencies]
sqlx-doris = {{ path = {json.dumps(str(project / "crates/sqlx-doris"))}, features = ["migrate"] }}
sqlx = {{ version = "=0.9.0", default-features = false, features = ["derive", "macros", "migrate"] }}
tokio = {{ version = "1", features = ["macros", "rt-multi-thread"] }}
"""
(directory / "Cargo.toml").write_text(manifest)
(directory / "src/main.rs").write_text(
    (project / "crates/sqlx-doris/examples/query.rs").read_text()
)
prefix = ["cargo", "--offline"]
manifest_args = ["--manifest-path", str(directory / "Cargo.toml")]
run([[*prefix, "check", *manifest_args]], "consumer.log")
# Cargo metadata can include weak optional SQLx dependencies that are never
# built. Audit the actual normal/build feature graph used by Cargo instead.
tree = subprocess.check_output(
    [
        *prefix,
        "tree",
        *manifest_args,
        "--features",
        "sqlx-doris/cli-admin-kafka,sqlx-doris/macros,sqlx-doris/stream-load",
        "--edges",
        "normal,build",
        "--prefix",
        "none",
        "--format",
        "{p}",
    ],
    text=True,
    cwd=directory,
)
(artifacts / "consumer-dependencies.txt").write_text(tree)
forbidden = {"sqlx-mysql", "sqlx-doris-mysql", "sqlx-postgres", "sqlx-sqlite"}
extra = forbidden.intersection(line.split()[0] for line in tree.splitlines() if line)
if extra:
    raise SystemExit(f"Unexpected database drivers: {sorted(extra)}")
# Check the complete Doris feature combination with upstream generic SQLx APIs.
run(
    [
        [
            *prefix,
            "check",
            *manifest_args,
            "--features",
            "sqlx-doris/cli-admin-kafka,sqlx-doris/macros,sqlx-doris/stream-load",
        ]
    ],
    "consumer-feature-unification.log",
)
if args.live:
    os.environ["DORIS_URL"] = os.environ["DORIS_TEST_URL"]
    run([[*prefix, "run", *manifest_args]], "consumer-live.log")
