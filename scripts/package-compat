#!/usr/bin/env python3
"""Bundle the current SDK and its bundled SQLx driver as a patch-free source tree."""
import hashlib
import gzip
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile

project = Path(__file__).resolve().parents[1]
if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    os.execv(
        str(project / "scripts/dev"),
        [
            str(project / "scripts/dev"),
            sys.executable,
            "-B",
            str(Path(__file__).resolve()),
        ],
    )
subprocess.run([str(project / "scripts/check-sqlx-patch")], check=True)
packages = Path(os.environ["CARGO_TARGET_DIR"]) / "package"
archive = packages / "sqlx-doris-compat-0.1.0.tar.gz"
with tempfile.TemporaryDirectory(prefix="compat-bundle-") as temporary:
    stage = Path(temporary) / "sqlx-doris-compat-0.1.0"
    stage.mkdir()
    for name in ("sqlx-doris", "sqlx-mysql"):
        shutil.copytree(
            project / "crates" / name,
            stage / "crates" / name,
            ignore=shutil.ignore_patterns("target", ".cargo", "*.crate"),
        )
    (stage / "patches").mkdir()
    for name in [
        "README.md",
        "README.en.md",
        "sqlx-mysql-provenance.json",
        "prepare-ok.patch",
        "native-transactions.patch",
        "safe-bindings.patch",
    ]:
        shutil.copy2(project / "patches" / name, stage / "patches" / name)
    (stage / "README.md").write_text(
        """# sqlx-doris 0.1.0 配套包

简体中文 | [English](README.en.md)

本包以源码形式提供 SDK 和随附的 sqlx-mysql 0.9.0 驱动，两者都在 `crates/` 下。
应用只需对 SDK 目录使用 path 依赖，驱动由 SDK 内的 path 依赖解析，**不需要** `[patch.crates-io]`：

```toml
[dependencies]
sqlx-doris = { path = "crates/sqlx-doris" }
```

查询、参数绑定和连接池使用 `sqlx_doris::sqlx::{query_as, ...}` 与 `sqlx_doris::MySqlPool`；
只有在需要 `FromRow` 派生宏时才另加 `sqlx = { version = "=0.9.0", default-features = false, features = ["derive"] }`。
完整步骤见 [SDK 安装指南](crates/sqlx-doris/README.md)。

[驱动说明](patches/README.md)记录兼容处理、来源和许可证。
完整使用、兼容范围和测试说明见源码包的 docs 目录。本版本尚未公开发布。
"""
    )
    (stage / "README.en.md").write_text(
        """# sqlx-doris 0.1.0 compatibility bundle

[简体中文](README.md) | English

This bundle ships the SDK and the bundled sqlx-mysql 0.9.0 driver as source under `crates/`.
Point your application at the SDK directory; the driver resolves through the SDK's own path
dependency, so **no** `[patch.crates-io]` entry is needed:

```toml
[dependencies]
sqlx-doris = { path = "crates/sqlx-doris" }
```

Use `sqlx_doris::sqlx::{query_as, ...}` and `sqlx_doris::MySqlPool` for queries, binding, and pools.
Add `sqlx = { version = "=0.9.0", default-features = false, features = ["derive"] }` only when you
want the `FromRow` derive macro.
See the [SDK installation guide](crates/sqlx-doris/README.en.md) for the full steps.

The [driver guide](patches/README.en.md) describes compatibility, provenance, and licenses.
Full usage, compatibility, and testing guides are in the source archive's docs directory.
This version is not publicly released.
"""
    )
    files = {
        str(p.relative_to(stage)): hashlib.sha256(p.read_bytes()).hexdigest()
        for p in stage.rglob("*")
        if p.is_file()
    }
    (stage / "SHA256SUMS.json").write_text(json.dumps(files, indent=2) + "\n")

    # Stable tar and gzip metadata make an unchanged delivery byte-reproducible.
    def normalized(member):
        member.mtime = 0
        member.uid = member.gid = 0
        member.uname = member.gname = ""
        member.pax_headers = {}
        member.mode = 0o755 if member.isdir() or member.mode & 0o111 else 0o644
        return member

    with archive.open("wb") as raw, gzip.GzipFile(
        filename="", mode="wb", fileobj=raw, mtime=0
    ) as compressed:
        with tarfile.open(
            fileobj=compressed, mode="w", format=tarfile.GNU_FORMAT
        ) as output:
            output.add(stage, arcname=stage.name, filter=normalized)
summary = {
    "archive": str(archive),
    "sha256": hashlib.sha256(archive.read_bytes()).hexdigest(),
    "files": len(files) + 1,
    "root_cargo_patch_required": False,
}
(packages / "sqlx-doris-compat-0.1.0.json").write_text(
    json.dumps(summary, indent=2) + "\n"
)
print(json.dumps(summary, indent=2))
