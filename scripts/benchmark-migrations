#!/usr/bin/env python3
"""Measure first apply, incremental apply and unchanged migration checks."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *
import json
import statistics
from datetime import datetime, timezone

if not os.environ.get("DORIS_TEST_URL"):
    raise SystemExit("DORIS_TEST_URL is required")
directory = Path(os.environ["SQLX_DORIS_BUILD_ROOT"]) / "native-migration-benchmark"
(directory / "src").mkdir(parents=True, exist_ok=True)
(directory / "Cargo.toml").write_text(
    f"""[package]
name = "doris-migration-benchmark"
version = "0.0.0"
edition = "2024"
[workspace]
[dependencies]
sqlx-doris = {{ path = {json.dumps(str(project / 'crates/sqlx-doris'))}, features = ["migrate"] }}
sqlx = {{ version = "=0.9.0", default-features = false, features = ["macros", "migrate"] }}
tokio = {{ version = "1", features = ["macros", "rt-multi-thread"] }}
"""
)
(directory / "src/main.rs").write_text(
    (project / "tests/fixtures/benchmark_migrations.rs").read_text()
)
run(
    [
        [
            "cargo",
            "run",
            "--offline",
            "--release",
            "--manifest-path",
            str(directory / "Cargo.toml"),
        ]
    ],
    "benchmark-migrations.log",
)
records = [
    json.loads(line)
    for line in (artifacts / "benchmark-migrations.log").read_text().splitlines()
    if line.startswith("{")
]
median = {}
for mode, count in (("first_apply", 1), ("incremental_apply", 5), ("unchanged", 5)):
    values = [r["ms"] for r in records if r["mode"] == mode]
    if len(values) != count:
        raise SystemExit(f"incomplete benchmark: {mode}")
    median[mode] = statistics.median(values)
summary = dict(
    measured_at_utc=datetime.now(timezone.utc).isoformat(),
    records=records,
    median_ms=median,
)
(artifacts / "benchmark-migrations.json").write_text(
    json.dumps(summary, indent=2) + "\n"
)
print(json.dumps(median, indent=2))
