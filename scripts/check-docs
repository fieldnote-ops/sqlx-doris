#!/usr/bin/env python3
"""Check user-facing documentation links and standalone-driver packaging rules."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *
from _docs import validate

summary = validate(project)
packages = workspace_packages()
if (project / "target").exists() or (project / "crates/sqlx-mysql").exists():
    raise SystemExit(
        "Build outputs and bundled MySQL driver must not be in the repository"
    )
for member in ("crates/sqlx-doris", "crates/sqlx-doris-core"):
    source = project / member / "src/lib.rs"
    if "pub mod sqlx" in source.read_text() or (source.parent / "sqlx.rs").exists():
        raise SystemExit(
            "Use upstream SQLx directly; do not restore the public SQLx facade"
        )
print(f"Bilingual documentation and standalone layout passed: {summary}")
