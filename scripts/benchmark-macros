#!/usr/bin/env python3
"""Compare query! and runtime query_as on the same Doris connection and SQL."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *
import json
import statistics
from datetime import datetime, timezone

url = os.environ.get("DORIS_TEST_URL")
if not url:
    raise SystemExit("DORIS_TEST_URL is required")
directory = Path(os.environ["SQLX_DORIS_BUILD_ROOT"]) / "native-macro-benchmark"
(directory / "src").mkdir(parents=True, exist_ok=True)
(directory / "Cargo.toml").write_text(
    f"""[package]
name = "doris-macro-benchmark"
version = "0.0.0"
edition = "2024"
[workspace]
[dependencies]
sqlx-doris = {{ path = {json.dumps(str(project / 'crates/sqlx-doris'))}, features = ["macros"] }}
sqlx = {{ version = "=0.9.0", default-features = false, features = ["derive"] }}
tokio = {{ version = "1", features = ["macros", "rt-multi-thread"] }}
"""
)
(directory / "src/main.rs").write_text(
    (project / "tests/fixtures/benchmark_macros.rs").read_text()
)
env = os.environ.copy()
env.update(DATABASE_URL=url, SQLX_OFFLINE="false")
run(
    [
        [
            "cargo",
            "run",
            "--offline",
            "--release",
            "--manifest-path",
            str(directory / "Cargo.toml"),
        ]
    ],
    "benchmark-macros.log",
    env,
)
records = [
    json.loads(line)
    for line in (artifacts / "benchmark-macros.log").read_text().splitlines()
    if line.startswith("{")
]
median = {}
for mode in ("checked", "runtime"):
    samples = [r for r in records if r["mode"] == mode]
    if len(samples) != 5:
        raise SystemExit(f"incomplete benchmark: {mode}")
    median[mode] = {
        key: statistics.median(r[key] for r in samples)
        for key in ("qps", "p50_ms", "p95_ms", "p99_ms")
    }
summary = dict(
    measured_at_utc=datetime.now(timezone.utc).isoformat(),
    records=records,
    median=median,
    rustc=subprocess.check_output(["rustc", "--version"], text=True).strip(),
)
(artifacts / "benchmark-macros.json").write_text(json.dumps(summary, indent=2) + "\n")
print(json.dumps(median, indent=2))
