#!/usr/bin/env python3
"""Verify the standalone driver, documentation, formatting, consumers and package."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *

commands = [
    [sys.executable, "-B", "scripts/check-docs"],
    [sys.executable, "-B", "scripts/format", "--check"],
    [
        "cargo",
        "clippy",
        "--locked",
        "--offline",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings",
    ],
    [sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-v"],
    ["cargo", "test", "--locked", "--offline", "--workspace", "--all-features"],
    [
        "cargo",
        "check",
        "--locked",
        "--offline",
        "--workspace",
        "--no-default-features",
        "--all-targets",
    ],
    [
        "cargo",
        "doc",
        "--locked",
        "--offline",
        "--workspace",
        "--all-features",
        "--no-deps",
    ],
    [sys.executable, "-B", "scripts/test-package"],
    [sys.executable, "-B", "scripts/test-consumer"],
    [sys.executable, "-B", "scripts/test-docs"],
]
env = os.environ.copy()
env["RUSTDOCFLAGS"] = (
    "-D missing-docs -D rustdoc::broken_intra_doc_links -D rustdoc::invalid_html_tags"
)
run(commands, "check.log", env)
