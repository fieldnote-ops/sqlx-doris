#!/usr/bin/env python3
"""Execute the documented Doris examples against dedicated endpoints."""
import os
import sys
from pathlib import Path

if os.environ.get("SQLX_DORIS_DEV_ACTIVE") != "1":
    dev = Path(__file__).resolve().parent / "dev"
    os.execv(str(dev), [str(dev), sys.executable, "-B", *sys.argv])
from _common import *

for key in ("DORIS_TEST_URL", "DORIS_HTTP_URL", "DORIS_BE_HTTP_URL"):
    if not os.environ.get(key):
        raise SystemExit(f"{key} is required")
os.environ["DORIS_URL"] = os.environ["DORIS_TEST_URL"]
run(
    [
        ["cargo", "run", "--locked", "--offline", "--all-features", "--example", name]
        for name in ("query", "native_types", "stream_load")
    ],
    "examples.log",
)
